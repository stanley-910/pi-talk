{
  "name": "@twinfantasyfan/pi-talk",
  "version": "0.1.0",
  "description": "Pi extension that reads completed assistant responses aloud with OpenAI text-to-speech and mpv",
  "license": "MIT",
  "author": "Stanley Wang",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "text-to-speech",
    "tts",
    "openai",
    "mpv"
  ],
  "homepage": "https://github.com/stanley-910/pi-talk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stanley-910/pi-talk.git"
  },
  "bugs": {
    "url": "https://github.com/stanley-910/pi-talk/issues"
  },
  "files": [
    "src/index.ts",
    "src/clean.ts",
    "src/controls.ts",
    "src/floor.ts",
    "src/speaker.ts",
    "src/speech.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "pi --no-extensions -e ./src/index.ts",
    "test": "node --test test/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "0.80.7"
  }
}
